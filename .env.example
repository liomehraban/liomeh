# Fuente de datos: mock (default) | supabase (futuro)
NEXT_PUBLIC_DATA_SOURCE=mock

# Mapas: maplibre (default, sin key) | google
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Tipo de cambio de referencia para mostrar ≈USD en inglés
NEXT_PUBLIC_USD_RATE=18.5

# Asistente Marchanta (opcional; sin estas variables usa respuestas guionadas)
ANTHROPIC_API_KEY=
# Pon aquí el id del modelo de Claude que quieras usar (ver docs.claude.com/en/docs/about-claude/models).
# Sugerido: claude-opus-5-5. Es obligatorio junto con la key; sin ambos, el asistente usa respuestas guionadas.
ANTHROPIC_MODEL=

# Supabase (futuro, no se usa en la etapa mock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
