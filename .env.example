# Fuente de datos: mock (default) | supabase (futuro)
NEXT_PUBLIC_DATA_SOURCE=mock

# Mapas: maplibre (default, sin key) | google
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Tipo de cambio de referencia para mostrar ≈USD en inglés
NEXT_PUBLIC_USD_RATE=18.5

# Asistente Marchanta: en esta etapa es simulado (preguntas rápidas con respuestas preguardadas).
# No usa ninguna API ni necesita variables.

# Supabase (futuro, no se usa en la etapa mock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
